{
  "name": "il2cppdumper-studio",
  "private": true,
  "version": "6.8.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/bridge.cjs\" \"vite\"",
    "server": "node server/bridge.cjs",
    "client": "vite",
    "build:engine": "dotnet build engine/Il2CppDumper/Il2CppDumper.csproj -c Release",
    "build:gui": "tsc -b && vite build",
    "build": "npm run build:engine && npm run build:gui",
    "electron": "electron .",
    "package": "npm run build && electron-builder --win nsis portable",
    "package:dir": "npm run build && electron-builder --win --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.65.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.16.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.il2cppdumper.workstation",
    "productName": "Il2CppDumper-Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "extraResources": [
      {
        "from": "engine/Il2CppDumper/bin/Release/net8.0",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "engine/Il2CppDumper",
        "to": "engine",
        "filter": [
          "*.py",
          "config.json"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "workspace",
        "to": "workspace",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
